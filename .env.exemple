
# Database Credentials
DB_MYSQL_PASSWORD=your_mysql_password
DB_POSTGRES_PASSWORD=your_postgres_password
DB_MONGO_PASSWORD=your_mongo_password

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=my-database-backups

# Google Cloud Storage
GCS_CREDENTIALS_PATH=/path/to/gcs-credentials.json
GCS_BUCKET_NAME=my-gcs-backups

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_CONTAINER_NAME=database-backups

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#database-backups

# Backup Settings
BACKUP_RETENTION_DAYS=30
DEFAULT_COMPRESSION=gzip
DEFAULT_STORAGE=local

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/dbbackup/backup.log
